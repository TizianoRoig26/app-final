# Configuración de Entorno - Backend FastAPI

# Parámetros del Proyecto
PROJECT_NAME="Sistema de Evaluación de Vulnerabilidades"
API_V1_STR="/api/v1"
SECRET_KEY="super_secret_jwt_key_scanning_platform_2026_dev"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de Datos PostgreSQL
# Si el servicio no está levantado en este host, el sistema conmuta automáticamente a sqlite:///./scans.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vulnerabilities"

# Integración con Plataforma n8n
N8N_WEBHOOK_URL="http://localhost:5678/webhook/trigger-scan"
N8N_API_KEY=""

# Parámetros por Defecto de Escaneo
DEFAULT_SCAN_CRON="02:00"
DEFAULT_SCAN_CIDR="192.168.100.0/24"
