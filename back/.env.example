# Configuración de Entorno - Backend FastAPI
# Copiar como .env y ajustar valores para el entorno de despliegue.
# Las credenciales de PostgreSQL deben coincidir con las del servicio definido
# en Final/infra/n8n/docker-compose.yml (sección postgres).

# ── Proyecto ────────────────────────────────────────────────────────────────
PROJECT_NAME="Sistema de Evaluación de Vulnerabilidades TASTSERV"
API_V1_STR="/api/v1"
# Cambiar en producción por un valor aleatorio de al menos 32 caracteres
SECRET_KEY="super_secret_jwt_key_scanning_platform_2026_dev"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Base de Datos PostgreSQL ─────────────────────────────────────────────────
# Despliegue con docker-compose (red interna Docker → host "db"):
#   DATABASE_URL="postgresql://n8n_user:secure_password@db:5432/security_scans"
# Despliegue externo apuntando a la instancia de Final (puerto host 5433):
#   DATABASE_URL="postgresql://n8n_user:secure_password@<host-final>:5433/security_scans"
# Fallback automático a SQLite si PostgreSQL no está disponible (solo desarrollo):
DATABASE_URL="postgresql://n8n_user:secure_password@localhost:5433/security_scans"

# ── Integración con n8n ──────────────────────────────────────────────────────
# URL base de la instancia n8n (sin barra final)
N8N_BASE_URL="http://localhost:5678"

# ID del workflow de escaneo (valor fijo del workflow actual-20261105.json)
N8N_WORKFLOW_ID="eZcFfWr0YiA2pAE3"

# URL completa del Webhook de disparo manual (nodo "Webhook - Trigger Scan")
# Ruta del nodo: trigger-scan  |  Método: POST  |  Auth: headerAuth
N8N_WEBHOOK_URL="http://localhost:5678/webhook/trigger-scan"

# API Key de n8n para la REST API (/api/v1/workflows/{id}/run) — opcional
N8N_API_KEY=""

# Secret / valor del header de autenticación del Webhook (credencial webhookHeaderAuth01)
# El nombre del header y su valor se configuran manualmente en n8n.
# El backend lo envía como: X-N8N-API-KEY: <este valor>
N8N_WEBHOOK_SECRET=""

# ── Escaneo ──────────────────────────────────────────────────────────────────
# Hora de disparo automático del cron en n8n (formato HH:MM, solo referencia UI)
DEFAULT_SCAN_CRON="02:00"
# CIDR objetivo por defecto para disparos manuales desde la UI
DEFAULT_SCAN_CIDR="172.18.0.200 172.18.0.201 172.18.0.202"

# ── CORS (producción) ────────────────────────────────────────────────────────
# Orígenes permitidos separados por comas (en producción no usar "*")
# Ejemplo: CORS_ORIGINS="https://mi-dominio.com,https://www.mi-dominio.com"
CORS_ORIGINS="*"
